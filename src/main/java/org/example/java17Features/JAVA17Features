3. Enhanced RNG (Random Number Generation API)
New interfaces & algorithms in java.util.random package.


import java.util.random.RandomGenerator;
import java.util.random.RandomGeneratorFactory;

public class RNGDemo {
    public static void main(String[] args) {
        // List available algorithms
        RandomGeneratorFactory.all()
            .map(RandomGeneratorFactory::name)
            .limit(5)
            .forEach(System.out::println);

        // Pick a specific algorithm
        RandomGenerator l64x128 = RandomGeneratorFactory.of("L64X128MixRandom").create(12345L);
        System.out.println(l64x128.nextInt());
        System.out.println(l64x128.nextDouble());

        // Jumpable generator for parallel streams:
        var factory = RandomGeneratorFactory.of("L64X256MixRandom");
        var base = factory.create();
        var split = base.split(); // Independent generator
        System.out.println(base.nextInt() + " | " + split.nextInt());
    }
}
Why: Better performance, ability to split or jump sequences for parallel/simulations.

